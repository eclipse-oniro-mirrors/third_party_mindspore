import("//build/ohos.gni")

ohos_executable("benchmark_bin") {
  sources = [
    "../../../ccsrc/plugin/device/cpu/kernel/nnacl/nnacl_common.c",
    "../../src/common/config_file.cc",
    "../../src/common/file_utils.cc",
    "../../src/common/utils.cc",
    "../common/flag_parser.cc",
    "../common/opengl_util.cc",
    "../common/string_util.cc",
    "benchmark_base.cc",
    "benchmark_c_api.cc",
    "benchmark_unified_api.cc",
    "main.cc",
    "run_benchmark.cc",
  ]

  include_dirs = [
    "//third_party/flatbuffers/include",
    "../../",  # src
    "../../../core/",  # core
    "../../../../",  #
    "../../../../third_party/",  # third_party
    "../../../ccsrc/plugin/device/cpu/kernel/",  # nnacl
  ]

  defines = [ "MS_COMPILE_OHOS" ]

  if (target_cpu == "arm") {
    defines += [
      "ENABLE_ARM",
      "ENABLE_ARM32",
    ]
  } else if (target_cpu == "arm64") {
    defines += [
      "ENABLE_ARM",
      "ENABLE_ARM64",
    ]
  }
  remove_configs = [ "//build/config/compiler:no_rtti" ]
  cflags_cc = [ "-Wno-unused-const-variable" ]
  deps = [
    "../../:mindspore_lib",
    "../../:mindspore_ndk",
  ]

  output_name = "benchmark_bin"
  install_enable = true
  part_name = "mindspore"
}
