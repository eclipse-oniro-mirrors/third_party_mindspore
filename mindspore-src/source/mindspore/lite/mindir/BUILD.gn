import("//build/ohos.gni")

# ohos_group("mindir_test") {
#   deps = [
#     "tests:mindir_test",
#   ]
# }

config("mindir_config") {
  include_dirs = [ "include" ]
}

config("mindir_secure_disable_android") {
  cflags = [
    "-UANDROID",
    "-U__ANDROID__",
    "-U__ANDROID_API__",
    "-fstack-protector-all",
    "-D_FORTIFY_SOURCE=2",
  ]
  cflags_cc = [
    "-UANDROID",
    "-U__ANDROID__",
    "-U__ANDROID_API__",
  ]
  ldflags = [ "-Wl,--no-as-needed" ]
}

ohos_shared_library("mindir_lib") {
  branch_protector_ret = "pac_ret"
  include_dirs = [
    "../",
    "../../core",
    "inner_headers",
    "../../../../../../../third_party/flatbuffers/include",
    "../../../../../../../third_party/bounds_checking_function/include",
    "../../../../../../../base/hiviewdfx/hilog/interfaces/native/innerkits/include",
  ]
  sources = [
    "src/log.cc",
    "src/mindir.cc",
    "src/mindir_1.cc",
    "src/mindir_2.cc",
    "src/mindir_memory_manager.cc",
    "src/mindir_nnrt_lite_graph.cc",
    "src/mindir_tensor.cc",
    "src/utils.cc",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "drivers_interface_nnrt:libnnrt_proxy_1.0",
    "drivers_interface_nnrt:libnnrt_proxy_2.0",
    "drivers_interface_nnrt:nnrt_idl_headers",
    "hdf_core:libhdi",
    "hilog:libhilog",
  ]
  public_external_deps = [ "flatbuffers:libflatbuffers_static" ]
  configs = [ ":mindir_secure_disable_android" ]
  public_configs = [ ":mindir_config" ]
  defines = [ "MS_COMPILE_OHOS" ]
  output_name = "mindir"
  innerapi_tags = [ "platformsdk_indirect" ]
  part_name = "mindspore"
  subsystem_name = "thirdparty"
}
