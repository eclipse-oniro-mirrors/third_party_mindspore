import("//build/ohos.gni")

config("nnacl_public_config") {
  include_dirs = [
    "../",
    "include/",
  ]

  configs = [ "../../../../../../lite:disable_android" ]

  defines = [ "MS_COMPILE_OHOS" ]
  cflags_c = [
    "-fomit-frame-pointer",
    "-fstrict-aliasing",
    "-Wno-ignored-qualifiers",
    "-Wno-unknown-pragmas",
  ]
  if (target_cpu == "arm" || target_cpu == "arm64") {
    defines += [
      "ENABLE_ARM",
      "ENABLE_NEON",
    ]
    cflags_c += [ "-march=armv8.2-a+dotprod+fp16" ]
    if (target_cpu == "arm") {
      defines += [ "ENABLE_ARM32" ]
    } else if (target_cpu == "arm64") {
      defines += [
        "ENABLE_ARM64",
        "ENABLE_FP16",
      ]
      cflags_c += [ "-flax-vector-conversions" ]
    }
  } else if (target_cpu == "x86_64") {
    cflags_c += [
      "-mavx",
      "-mavx2",
      "-mfma",
      "-msse4.1",
      "-fPIC",
    ]
    defines += [
      "ENABLE_SSE",
      "ENABLE_AVX",
    ]

    # emulator not support avx512
    if (!is_emulator) {
      cflags_c += [ "-mavx512f" ]
      defines += [ "ENABLE_AVX512" ]
    }
  }
}

ohos_source_set("nnacl_obj") {
  deps = [
    ":nnacl_common",
    ":nnacl_no_fast_math",
  ]
  part_name = "mindspore"
  subsystem_name = "thirdparty"
}

