import("//build/ohos.gni")
ohos_source_set("mindrt_obj") {
  sources = [
    "src/actor/actor.cc",
    "src/actor/actormgr.cc",
    "src/actor/aid.cc",
    "src/actor/mailbox.cc",
    "src/actor/op_actor.cc",
    "src/async/future.cc",
    "src/async/uuid_base.cc",
    "src/async/uuid_generator.cc",
    "src/fork_utils.cc",
    "src/mindrt.cc",
    "src/thread/actor_threadpool.cc",
    "src/thread/core_affinity.cc",
    "src/thread/parallel_thread_pool_manager.cc",
    "src/thread/parallel_threadpool.cc",
    "src/thread/threadpool.cc",
  ]
  include_dirs = [
    "./",
    "include/",
    "src/",
    "../../lite/",
    "../../lite/src/",
    "../../core/",
  ]

  defines = [
    "ENABLE_MINDRT",
    "MS_COMPILE_OHOS",
    "BUILD_LITE",
  ]

  external_deps = [ "hilog:libhilog" ]

  remove_configs = [ "//build/config/compiler:no_rtti" ]

  part_name = "mindspore"
  subsystem_name = "thirdparty"
}
